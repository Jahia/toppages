<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jahia.modules</groupId>
    <artifactId>jahia-modules</artifactId>
    <version>8.1.0.0</version>
  </parent>
  <groupId>org.toppages.modules</groupId>
  <artifactId>toppages</artifactId>
  <version>3.0.1-SNAPSHOT</version>
  <packaging>bundle</packaging>
  <name>topPages</name>
  <description>This is a community module to get the top pages from awstats, compatible with Jahia 8</description>
  <scm>
    <connection>scm:git:git@github.com:Jahia/toppages.git</connection>
    <developerConnection>scm:git:git@github.com:Jahia/toppages.git</developerConnection>
    <url>https://github.com/Jahia/toppages.git</url>
    <tag>HEAD</tag>
  </scm>
  <properties>
    <jahia-depends>default,serverSettings</jahia-depends>
    <!--
      No osgi.extender require-capability, and no META-INF/spring: this module has no Spring
      context and needs none. Every service is an OSGi Declarative Services component, and the
      administration screen is a React route in the Jahia app shell rather than a Spring Web Flow -
      the flow was the only thing that needed a context, because WebflowDispatcherScript resolves
      its executor through JahiaTemplatesPackage.getContext().
    -->
    <node.version>v18.20.4</node.version>
  </properties>
  <dependencies>
    <!--
      Compile-time only: the OSGi Declarative Services annotations have CLASS retention and are
      read by bnd at package time to generate OSGI-INF/*.xml and the Service-Component header.
      provided scope keeps them out of Embed-Dependency and out of the bundle.
    -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <version>1.3.0</version>
      <scope>provided</scope>
    </dependency>
    <!--
      GraphQL schema extension. provided, because both are OSGi bundles the platform already
      runs: graphql-dxm-provider exports org.jahia.modules.graphql.provider.dxm* and
      graphql-java-annotations exports graphql.annotations.annotationTypes, and bnd wires the
      module to those exports. Embedding either would give this bundle a second, unwired copy of
      the annotation classes, and the provider would then not recognise our extensions.
      The compile version only has to be old enough: bnd derives an Import-Package range of
      [3.10,4) from it, which the 3.11.x the platform currently ships satisfies. Like every other
      import of this bundle, it comes out optional, so a platform without the provider still
      resolves the module.
    -->
    <dependency>
      <groupId>org.jahia.modules</groupId>
      <artifactId>graphql-dxm-provider</artifactId>
      <version>3.10.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.github.graphql-java</groupId>
      <artifactId>graphql-java-annotations</artifactId>
      <version>21.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.23.1</version>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents</groupId>
      <artifactId>httpclient-osgi</artifactId>
      <version>4.5.14</version>
    </dependency>
  </dependencies>
  <repositories>
    <repository>
      <releases>
        <enabled>true</enabled>
        <updatePolicy>never</updatePolicy>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>jahia-public</id>
      <name>Jahia Public Repository</name>
      <url>https://devtools.jahia.com/nexus/content/groups/public</url>
    </repository>
  </repositories>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <!-- Scan every class for DS annotations and emit OSGI-INF/*.xml + Service-Component. -->
            <_dsannotations>*</_dsannotations>
          </instructions>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>8</source>
          <target>8</target>
        </configuration>
      </plugin>
      <!--
        The administration UI is a React application, bundled by webpack as a Module Federation
        remote (see webpack.config.js). It has to be built before process-resources, because its
        output lands in src/main/resources/javascript/apps and is picked up from there like any
        other static resource - hence generate-resources for all three executions.

        Node and npm are downloaded into ./node rather than taken from the machine, so the jar does
        not depend on whatever happens to be on the developer's PATH; ./node and node_modules are
        both git-ignored. `npm ci` rather than `npm install`, so the build installs exactly what
        package-lock.json pins and fails instead of silently resolving something newer.
      -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.4</version>
        <executions>
          <execution>
            <id>install-node-and-npm</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
            <configuration>
              <nodeVersion>${node.version}</nodeVersion>
            </configuration>
          </execution>
          <execution>
            <id>npm-ci</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>ci</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm-run-build</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
