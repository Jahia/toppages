<?xml version="1.0" encoding="UTF-8"?>
<!--
  This file declares NO beans, and must not be used to declare any: every bean this module used
  to define is now an OSGi Declarative Services component under src/main/java, registered through
  the annotations on those classes and described by the generated OSGI-INF/*.xml.

  It exists only so that the module still gets a Spring application context. Spring Web Flow needs
  one: org.jahia.services.render.webflow.WebflowDispatcherScript.execute() resolves the flow
  executor with JahiaTemplatesPackage.getContext().getBean(...), and getContext() is null for a
  module the Spring extender never built a context for. Without this file (and without the
  matching osgi.extender require-capability in pom.xml) the server-settings page at
  Administration > Server > Configuration > Top Pages answers HTTP 500 with a NullPointerException
  and the flow never renders.

  The webflow at jtopmix_topPagesConfiguration/html/topPagesConfiguration.flow/ is scheduled to be
  replaced; this file and the require-capability go with it.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">
</beans>
